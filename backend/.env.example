# Server (Railway injects PORT automatically)
PORT=5001
NODE_ENV=development

# Database — variable name is MONGO_URI (not MONGODB_URI)
MONGO_URI=mongodb://localhost:27017/gearup

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Optional — Vercel frontend URL for CORS/email links (not required today; cors is open)
# FRONTEND_URL=https://your-app.vercel.app

# Dialogflow (optional)
DIALOGFLOW_PROJECT_ID=your-dialogflow-project-id
GOOGLE_APPLICATION_CREDENTIALS=config/your-service-account.json
# Railway: paste full service-account JSON as one line
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Email (optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Google OAuth (optional — server-side token verification)
# GOOGLE_CLIENT_ID=your-google-client-id
